<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required even though the only destination is loopback: Android gates
         socket(AF_INET, ...) creation on membership of AID_INET (gid 3003), which this
         permission grants. Without it the dial fails with
         "socket: permission denied" before any address is considered.
         core.aar declares no permissions of its own. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 2: real BLE. minSdk is 26, so BOTH permission models must be declared.

         Pre-31 Android gates BLE SCANNING behind a location permission - not because
         we want location, but because scan results can be used to infer it. Capped at
         30 so a modern device never sees a location prompt. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- 31+. neverForLocation asserts we do not derive physical location from scan
         results, which we do not: the only things read out of a ScanRecord are the
         device name and its manufacturer-data blob. That flag is what stops
         BLUETOOTH_SCAN from implying a location permission on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SquareGolf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SquareGolf"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden|keyboard|navigation|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
